{
	"name": "@dsbunny/transcoder-three-schema",
	"version": "3.0.3",
	"description": "Schema for the Transcoder THREE production transcoding service",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"author": "Steve-o <fnjordy@gmail.com>",
	"license": "MIT",
	"private": false,
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist node_modules package-lock.json",
		"pull:upstream": "./scripts/pull-upstream.sh",
		"rebuild": "npm run clean && npm run pull:upstream && npm install && npm run build",
		"test": "pnpm run build && node --test test/**/*.test.mjs"
	},
	"devDependencies": {
		"@dsbunny/error-schema": "github:dsbunny/error-schema#9f22488",
		"@dsbunny/metadata-schema": "github:dsbunny/metadata-schema#01a6e01",
		"@dsbunny/net-schema": "github:dsbunny/net-schema#89cb233",
		"@dsbunny/webhook-schema": "github:dsbunny/webhook-schema#545a076",
		"@dsbunny/zod-registry": "github:dsbunny/zod-registry#0873db4",
		"typescript": "^5.9.3",
		"zod": "^4.3.6"
	},
	"peerDependencies": {
		"@dsbunny/error-schema": "github:dsbunny/error-schema",
		"@dsbunny/metadata-schema": "github:dsbunny/metadata-schema",
		"@dsbunny/net-schema": "github:dsbunny/net-schema",
		"@dsbunny/webhook-schema": "github:dsbunny/webhook-schema",
		"@dsbunny/zod-registry": "github:dsbunny/zod-registry",
		"zod": "^4.3.0"
	}
}
